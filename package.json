{
  "name": "mboaflix-workspace",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "preinstall": "node scripts/check-package-manager.cjs",
    "dev": "pnpm --filter @workspace/mobile dev",
    "dev:offline": "pnpm --filter @workspace/mobile dev:offline",
    "android": "pnpm --filter @workspace/mobile android",
    "web": "pnpm --filter @workspace/mobile web",
    "build:web": "pnpm --filter @workspace/mobile build:web",
    "typecheck": "pnpm --filter @workspace/mobile typecheck"
  },
  "devDependencies": {
    "prettier": "^3.9.6",
    "typescript": "~5.9.3"
  }
}