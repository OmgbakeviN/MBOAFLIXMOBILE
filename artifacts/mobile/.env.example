# MBOA FLIX mobile environment variables
#
# Nkap now has a public production fallback URL in constants/api.ts:
# https://kevinomgba.pythonanywhere.com
#
# This environment variable is OPTIONAL and is useful when you want
# to point the app to another backend (local development/staging).
#
# Never put the OpenRouter API key in this mobile project.

EXPO_PUBLIC_NKAP_API_URL=https://kevinomgba.pythonanywhere.com
